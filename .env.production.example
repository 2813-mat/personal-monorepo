# Variáveis usadas pelo docker-compose.prod.yml em produção.
# No servidor, o workflow do GitHub Actions gera o .env real a partir dos
# secrets do repositório (não commitar o .env de verdade).

POSTGRES_USER=
POSTGRES_PASSWORD=
KC_DB_USERNAME=
KC_DB_PASSWORD=
KC_ADMIN_USERNAME=
KC_ADMIN_PASSWORD=

# Domínios públicos usados pela API e pelo Keycloak (serviços "api" e "keycloak")
WEB_ORIGIN=https://financeiro.bispotech.com
KEYCLOAK_PUBLIC_URL=https://financeiro-auth.bispotech.com
KEYCLOAK_REALM=caixa-familia
KEYCLOAK_CLIENT_ID=api-financial

# Config runtime da UI (injetada no container via config.js, ver apps/ui-financial/docker/)
UI_API_BASE_URL=https://financeiro-api.bispotech.com/api
UI_AUTH_AUTHORITY=https://financeiro-auth.bispotech.com/realms/caixa-familia
UI_AUTH_CLIENT_ID=ui-financial
